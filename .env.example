# Aether environment — copy to .env.local and fill in what you need.
# Nothing here is required for local mode: an empty file still starts.

# ---------------------------------------------------------------- mail relay
# Email-code sign-in, sign-up verification and password reset.
# Preferred: fill the relay in Settings → Email (stored encrypted in the data
# directory, effective immediately). Everything below still works and is the
# fallback for containers and CI, but a relay saved in the app outranks it.
# QQ Mail: enable "SMTP 服务" in the mailbox settings and use the 16-character
# authorization code (not the account password) as AETHER_SMTP_PASS.
# AETHER_SMTP_HOST=smtp.qq.com
# AETHER_SMTP_PORT=465
# AETHER_SMTP_SECURE=1
# AETHER_SMTP_STARTTLS=0
# AETHER_SMTP_USER=you@qq.com
# AETHER_SMTP_PASS=<authorization code>
# AETHER_SMTP_FROM=you@qq.com
# AETHER_SMTP_FROM_NAME=Aether
# AETHER_REQUIRE_EMAIL_VERIFICATION=1   # default: on when a relay is configured
# AETHER_EMAIL_ECHO=1                   # dev only: return the code in the API reply

# ------------------------------------------------------------------- sign-in
# SIGNUP_CODE=change-me                  # invite code for new accounts
# AUTH_DISABLED=1                        # single-user local mode, no sign-in
# LOCAL_USER_NAME=Me

# -------------------------------------------------------------------- agent
# Base URL and key are configured per account in Settings → Agent; these are
# only read by the desktop shell and the end-to-end tests.
# AGENT_ALLOWED_HOSTS=api.openai.com,api.deepseek.com

# -------------------------------------------------------------- web search
# Where the agent's `web_search` looks. Preferred: Settings → Web search saves
# an endpoint and the engine order into the data directory (effective on the
# very next search). The two variables below are the read-only fallback for
# containers; a saved source outranks them.
# A SearXNG instance is asked for `format=json` first and falls back to its
# HTML layout when the instance has JSON disabled.
# AETHER_SEARCH_URL=http://127.0.0.1:8888/search
# AETHER_SEARCH_ENGINES=duckduckgo,bing,sogou,baidu,360   # any subset, this order

# -------------------------------------------------------------------- paths
# LAB_DATA_DIR=E:\aether-data             # where accounts, workspaces and keys live
